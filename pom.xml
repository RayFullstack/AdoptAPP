<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

<modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/> </parent>
<groupId>com.adoptapp</groupId>
<artifactId>adoptapp</artifactId>
<version>1.0.0</version>

<packaging>pom</packaging>

<modules>
    <module>adoption-service</module>
    <module>donation-service</module>
    <module>followup-service</module>
    <module>health-service</module>
    <module>notification-service</module>
    <module>pet-service</module>
    <module>shelter-service</module>
    <module>staff-service</module>
    <module>supply-service</module>
    <module>user-service</module>
</modules>

<properties>
    <java.version>21</java.version>
    <flyway.version>10.21.0</flyway.version>
</properties>

<dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.5</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
        </dependency>
    </dependencies>
</dependencyManagement>

</project>